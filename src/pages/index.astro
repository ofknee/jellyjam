  <!-- Rules -->
  <section id="rules" class="py-40 bg-linear-to-b from-transparent via-[#C5E7F1]/8 to-transparent mt-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-20">
        <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">Rules</p>
        <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-0">
          The Rules
        </h2>
        <p class="text-[#5F7D95] max-w-2xl mx-auto mt-4">Short and simple.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="card group">
          <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">01</p>
          <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Originality</h3>
          <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
            All code and assets must be made during the hackathon, or be CC0 licensed. No pre-made templates are allowed.
          </p>
        </div>

        <div class="card group">
          <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">02</p>
          <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Teams</h3>
          <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
            Participate in teams of up to 3 people, or go solo.
          </p>
        </div>

        <div class="card group">
          <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">03</p>
          <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Be Respectful</h3>
          <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
            Be kind to everyone.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Location -->
  <section id="location" class="py-40">
    <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center gap-20">
      <div class="flex-1">
        <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">Where & When</p>
        <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-8">In Person</h2>
        <p class="text-lg text-[#5F7D95] mb-12 leading-relaxed">
          JellyJam 2026 is <span class="font-semibold text-[#4A4A4A]">fully in person</span> at [VENUE TBD]. One day, one venue, one theme.
        </p>
        <div class="space-y-4">
          <div class="glass p-6 rounded-2xl flex items-center gap-4 hover:bg-[#F8FAFC]/60 hover:translate-x-2 transition-all duration-300 group cursor-pointer">
            <span class="px-4 py-2 bg-[#C5E7F1]/40 rounded-lg font-secondary font-semibold text-[#82A7B9] text-sm">Location</span>
            <span class="font-semibold text-[#4A4A4A]">Location TBD</span>
          </div>
          <div class="glass p-6 rounded-2xl flex items-center gap-4 hover:bg-[#F8FAFC]/60 hover:translate-x-2 transition-all duration-300 group cursor-pointer">
            <span class="px-4 py-2 bg-[#C5E7F1]/40 rounded-lg font-secondary font-semibold text-[#82A7B9] text-sm">Date</span>
            <span class="font-semibold text-[#4A4A4A]">April 18, 2026</span>
          </div>
        </div>
      </div>
    </div>
  </section>

 <!-- Team -->
  <section id="team" class="max-w-6xl mx-auto py-40 px-6">
    <div class="text-center mb-20">
      <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">Organizers</p>
      <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-0">The Team</h2>
      <p class="text-[#5F7D95] text-lg font-light mt-4">Meet the people behind JellyJam.</p>
    </div>

    <!-- Row 1: 4 -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 justify-items-center mb-8">
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src={`${base}team_photos/temp.webp`} alt="Catherine Wang" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Catherine Wang</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Lead Organizer</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src={`${base}team_photos/avni.webp`} alt="Avni Harsh" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Avni Harsh</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Lead Organizer</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src={`${base}team_photos/maggie.jpg`} alt="Maggie Shen" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Maggie Shen</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Website Dev</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src={`${base}team_photos/eric.webp`} alt="Eric Ge" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Eric Ge</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Tech Lead</p>
      </div>
    </div>

    <!-- Row 2: 4 -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 justify-items-center mb-8">
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src={`${base}team_photos/agastya.webp`} alt="Agastya Kondamuri" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Agastya Kondamuri</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Operations</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src={`${base}team_photos/stephen.webp`} alt="Stephen King" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Stephen King</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Marketing</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src={`${base}team_photos/anisha.webp`} alt="Anisha Patil" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Anisha Patil</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Design</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src={`${base}team_photos/temp.webp`} alt="Rosina Lu" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Rosina Lu</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Sound</p>
      </div>
    </div>

    <!-- Row 3: 4 -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 justify-items-center">
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src={`${base}team_photos/yashika.webp`} alt="Yashika Agarwal" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Yashika Agarwal</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Community</p>
      </div>
      <div class="text-center group cursor-pointer">
