---
import MainLayout from '../layouts/MainLayout.astro';
import DiscordIcon from '../components/icons/Discord.astro';
import GithubIcon from '../components/icons/Github.astro';
import InstagramIcon from '../components/icons/Instagram.astro';
const base = import.meta.env.BASE_URL;
---

<MainLayout title="JellyJam 2026 | Leland CS Club">

  <!-- Hero -->
  <section id="top" class="min-h-screen flex flex-col items-center justify-start text-center px-4 relative pt-0 mt-24">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-glacier-blue/15 blur-[120px] -z-10"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-olive-green/10 blur-[120px] -z-10"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 w-80 h-80 bg-[#C5E7F1]/20 blur-[100px] -z-10 animate-wave"></div>

    <h1
      class="text-6xl md:text-8xl font-black mt-8 mb-6 bg-clip-text text-transparent leading-tight font-display tracking-tighter cursor-default select-none transition-all duration-500"
      style="background-image: linear-gradient(135deg, var(--color-glacier-blue), var(--color-ice-blue));"
    >
      Jelly Jam
    </h1>
    <p class="text-base md:text-lg text-[#5F7D95] max-w-xl font-light tracking-wide mb-2">A 10-hour game jam</p>
    <p class="text-sm text-[#5F7D95] mb-12 font-secondary">April 2026 · Leland CS Club</p>

    <a href="#about" class="glass px-8 py-3 rounded-full text-sm font-semibold text-[#82A7B9] tracking-wider border border-[#C5E7F1] hover:bg-[#C5E7F1]/20 hover:scale-105 active:scale-95 transition-all duration-300 cursor-pointer select-none">
      Register - April 2026
    </a>
  </section>

  <!-- About -->
  <section id="about" class="max-w-6xl mx-auto py-40 px-6 mt-24">
    <div class="text-center mb-20">
      <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">About</p>
      <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-0">
        What is Jelly Jam?
      </h2>
      <p class="text-[#5F7D95] max-w-2xl mx-auto mt-4">
        A weekend game jam for high school students. Build something, meet people, learn stuff.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="card group">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">01</p>
        <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">The Jam</h3>
        <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
          In about 10 hours, work solo or with a team to create a project that fits the theme. All skill levels welcome.
        </p>
      </div>

      <div class="card group">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">02</p>
        <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">The Theme</h3>
        <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
          The theme is revealed at kickoff. Interpret it however you want - mechanically, visually, narratively.
        </p>
      </div>

      <div class="card group">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">03</p>
        <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">The Awards</h3>
        <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
          The top games get showcased on this site and win prizes. Everyone plays and rates each other's games.
        </p>
      </div>
    </div>
  </section>

  <!-- Sponsors -->
  <section id="sponsors" class="py-28 border-y border-[#D9E4F5] mt-24">
    <p class="text-center text-xs uppercase tracking-widest mb-16 text-[#5F7D95] font-secondary">Sponsors</p>
    <div class="max-w-5xl mx-auto px-6 flex flex-wrap justify-center gap-12 grayscale opacity-70 hover:opacity-100 transition-all duration-300">
      <img src={`${base}logos/unity.svg`} alt="Unity" class="h-8 hover:scale-110 transition-transform" />
      <img src={`${base}logos/github.svg`} alt="GitHub" class="h-8 hover:scale-110 transition-transform" />
      <img src={`${base}logos/pico8.svg`} alt="PICO-8" class="h-8 hover:scale-110 transition-transform" />
    </div>
  </section>

  <!-- Rules -->
  <section id="rules" class="py-40 bg-linear-to-b from-transparent via-[#C5E7F1]/8 to-transparent mt-24">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-20">
        <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">Rules</p>
        <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-0">
          Rules
        </h2>
        <p class="text-[#5F7D95] max-w-2xl mx-auto mt-4">Short and simple.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="card group">
          <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">01</p>
          <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Original Work</h3>
          <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
            All code and assets must be made during the jam, or be CC0 licensed. No pre-made game templates.
          </p>
        </div>

        <div class="card group">
          <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">02</p>
          <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Be Respectful</h3>
          <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
            Be kind to everyone. We're here to make games and have fun.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Location -->
  <section id="location" class="py-40">
    <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center gap-20">
      <div class="flex-1">
        <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">Where & When</p>
        <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-8">In Person</h2>
        <p class="text-lg text-[#5F7D95] mb-12 leading-relaxed">
          Jelly Jam 2026 is <span class="font-semibold text-[#4A4A4A]">fully in person</span> at Leland High School. One day, one venue, one theme.
        </p>
        <div class="space-y-4">
          <div class="glass p-6 rounded-2xl flex items-center gap-4 hover:bg-[#F8FAFC]/60 hover:translate-x-2 transition-all duration-300 group cursor-pointer">
            <span class="px-4 py-2 bg-[#C5E7F1]/40 rounded-lg font-secondary font-semibold text-[#82A7B9] text-sm">Location</span>
            <span class="font-semibold text-[#4A4A4A]">Vineland Community Room</span>
          </div>
          <div class="glass p-6 rounded-2xl flex items-center gap-4 hover:bg-[#F8FAFC]/60 hover:translate-x-2 transition-all duration-300 group cursor-pointer">
            <span class="px-4 py-2 bg-[#C5E7F1]/40 rounded-lg font-secondary font-semibold text-[#82A7B9] text-sm">Date</span>
            <span class="font-semibold text-[#4A4A4A]">April 18, 2026</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section id="team" class="max-w-6xl mx-auto py-40 px-6">
    <div class="text-center mb-20">
      <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">Organizers</p>
      <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-0">The Team</h2>
      <p class="text-[#5F7D95] text-lg font-light mt-4">The people behind JellyJam.</p>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix" alt="Team member" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Captain Jellyfish</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Lead Organizer</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Marina" alt="Team member" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Marina Waters</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Co-Organizer</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Coral" alt="Team member" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Coral Reef</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Community</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Octane" alt="Team member" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Octane Dev</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Tech Lead</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Storm" alt="Team member" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Storm Abyss</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Operations</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Wave" alt="Team member" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Wave Rider</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Marketing</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Pulse" alt="Team member" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Pulse Deep</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Design</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Echo" alt="Team member" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Echo Fin</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Sound</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Surge" alt="Team member" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Surge Wave</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Community</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Lumina" alt="Team member" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Lumina Glow</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Sponsorships</p>
      </div>
      <div class="text-center group cursor-pointer">
        <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
          <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
            <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Tide" alt="Team member" class="group-hover:scale-110 transition-transform duration-300" />
          </div>
        </div>
        <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Tide Flow</h4>
        <p class="text-xs text-[#5F7D95] font-secondary mt-1">Events</p>
      </div>
    </div>
  </section>

  <!-- Prizes -->
  <section id="prizes" class="max-w-6xl mx-auto py-40 px-6 mt-24">
    <div class="text-center mb-20">
      <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">Awards</p>
      <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-0">
        Prizes
      </h2>
      <p class="text-[#5F7D95] max-w-2xl mx-auto mt-4">Rewards for great work.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="card group">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">1st Place</p>
        <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Gold</h3>
        <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
          TBD - check back soon.
        </p>
      </div>

      <div class="card group">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">2nd Place</p>
        <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Silver</h3>
        <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
          TBD - check back soon.
        </p>
      </div>

      <div class="card group">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">3rd Place</p>
        <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Bronze</h3>
        <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
          TBD - check back soon.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="max-w-4xl mx-auto py-40 px-6 mt-24">
    <div class="text-center mb-20">
      <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">Questions</p>
      <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-0">FAQ</h2>
      <p class="text-[#5F7D95] text-lg font-light mt-4">Answers to commonly asked questions.</p>
    </div>

    <div class="grid gap-6">
      <details class="glass rounded-2xl group cursor-pointer hover:bg-[#F8FAFC]/60 hover:shadow-[0_0_24px_rgba(197,231,241,0.4)] transition-all duration-300 overflow-hidden">
        <summary class="text-lg font-bold font-display list-none flex justify-between items-center text-[#4A4A4A] group-open:text-[#82A7B9] transition-colors duration-300 select-none p-8">
          What is a game jam?
          <span class="group-open:rotate-180 transition-transform duration-300 text-[#82A7B9] inline-block">↓</span>
        </summary>
        <div class="px-8 pb-8">
          <p class="text-[#5F7D95] leading-relaxed">
            A game jam is an event where you build a game from scratch in a short period of time. It's about creativity, learning, and having fun.
          </p>
        </div>
      </details>

      <details class="glass rounded-2xl group cursor-pointer hover:bg-[#F8FAFC]/60 hover:shadow-[0_0_24px_rgba(197,231,241,0.4)] transition-all duration-300 overflow-hidden">
        <summary class="text-lg font-bold font-display list-none flex justify-between items-center text-[#4A4A4A] group-open:text-[#82A7B9] transition-colors duration-300 select-none p-8">
          Am I eligible to participate?
          <span class="group-open:rotate-180 transition-transform duration-300 text-[#82A7B9] inline-block">↓</span>
        </summary>
        <div class="px-8 pb-8">
          <p class="text-[#5F7D95] leading-relaxed">
            If you're a teenager (13–18), you're welcome to come. No prior experience needed.
          </p>
        </div>
      </details>

      <details class="glass rounded-2xl group cursor-pointer hover:bg-[#F8FAFC]/60 hover:shadow-[0_0_24px_rgba(197,231,241,0.4)] transition-all duration-300 overflow-hidden">
        <summary class="text-lg font-bold font-display list-none flex justify-between items-center text-[#4A4A4A] group-open:text-[#82A7B9] transition-colors duration-300 select-none p-8">
          What if I don't have any experience?
          <span class="group-open:rotate-180 transition-transform duration-300 text-[#82A7B9] inline-block">↓</span>
        </summary>
        <div class="px-8 pb-8">
          <p class="text-[#5F7D95] leading-relaxed">
            That's totally fine. There'll be workshops and mentors throughout the day to help you out!
          </p>
        </div>
      </details>

      <details class="glass rounded-2xl group cursor-pointer hover:bg-[#F8FAFC]/60 hover:shadow-[0_0_24px_rgba(197,231,241,0.4)] transition-all duration-300 overflow-hidden">
        <summary class="text-lg font-bold font-display list-none flex justify-between items-center text-[#4A4A4A] group-open:text-[#82A7B9] transition-colors duration-300 select-none p-8">
          Is this free?
          <span class="group-open:rotate-180 transition-transform duration-300 text-[#82A7B9] inline-block">↓</span>
        </summary>
        <div class="px-8 pb-8">
          <p class="text-[#5F7D95] leading-relaxed">
            Yes, everything is free - food, swag,workshops, and prizes. Just show up!
          </p>
        </div>
      </details>

