---
import MainLayout from '../layouts/MainLayout.astro';
import DiscordIcon from '../components/icons/Discord.astro';
import GithubIcon from '../components/icons/Github.astro';
import InstagramIcon from '../components/icons/Instagram.astro';
const base = import.meta.env.BASE_URL;
---

<MainLayout title="JellyJam 2026 | Leland CS Club">

  <!-- Hero -->
  <section id="top" class="min-h-fit flex flex-col items-center justify-start text-center px-4 relative pt-0 mt-24">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-glacier-blue/15 blur-[120px] -z-10"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-olive-green/10 blur-[120px] -z-10"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 w-80 h-80 bg-[#C5E7F1]/20 blur-[100px] -z-10 animate-wave"></div>

    <h1
      class="text-6xl md:text-8xl font-black mt-8 mb-6 bg-clip-text text-transparent leading-tight font-display tracking-tighter cursor-default select-none transition-all duration-500"
      style="background-image: linear-gradient(135deg, var(--color-glacier-blue), var(--color-ice-blue));"
    >
      Jelly Jam
    </h1>
    <p class="text-base md:text-lg text-[#5F7D95] max-w-xl font-light tracking-wide mb-2">A 12-hour game jam in San Jose (Location TBD).</p>
    <p class="text-sm text-[#5F7D95] mb-12 font-secondary">Spring 2026 · Leland CS Club</p>

    <a href="https://forms.fillout.com/t/taUP71dZcYus" class="glass px-8 py-3 rounded-full text-sm font-semibold text-[#82A7B9] tracking-wider border border-[#C5E7F1] hover:bg-[#C5E7F1]/20 hover:scale-105 active:scale-95 transition-all duration-300 cursor-pointer select-none">
      Register — April 18, 2026
    </a>

     <a href="mailto:lhshacks2026@gmail.com" class="mt-4 glass px-6 py-2 rounded-full text-sm font-semibold text-[#82A7B9] tracking-wider border border-[#C5E7F1] hover:bg-[#C5E7F1]/20 hover:scale-105 active:scale-95 transition-all duration-300 cursor-pointer select-none">
      Contact Us
    </a>
  </section>

  <!-- About -->
  <section id="about" class="max-w-6xl mx-auto py-40 px-6 mt-24">
    <div class="text-center mb-20">
      <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">About</p>
      <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-0">
        What is JellyJam?
      </h2>
      <p class="text-[#5F7D95] max-w-2xl mx-auto mt-4">
        A day-long hackathon for middle and high school students.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="card group">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">01</p>
        <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">The Jam</h3>
        <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
          12 hours, one theme, endless ideas. Work solo or with a team — all skill levels welcome.
        </p>
      </div>

      <div class="card group">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">02</p>
        <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">The Theme</h3>
        <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
          The theme is marine conservation! ...
        </p>
      </div>

      <div class="card group">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">03</p>
        <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">The Awards</h3>
        <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
          Top games get showcased on this site and win prizes. Everyone plays and rates each other's games.
        </p>
      </div>
    </div>
  </section>

<!-- Schedule -->
<section id="schedule" class="py-40 bg-linear-to-b from-transparent via-[#C5E7F1]/8 to-transparent mt-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-20">
      <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">Day Of</p>
      <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-0">
        The Schedule
      </h2>
      <p class="text-[#5F7D95] max-w-2xl mx-auto mt-4">One day. Make something awesome.</p>
    </div>

    <div class="max-w-3xl mx-auto flex flex-col gap-4">

      <div class="card group flex items-start gap-6">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mt-1 w-28 shrink-0">9:00 – 9:45</p>
        <div>
          <h3 class="text-xl font-bold font-display text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Check In</h3>
          <p class="text-[#5F7D95] text-sm mt-1 leading-relaxed">Get settled, meet your team, and get ready to build.</p>
        </div>
      </div>

      <div class="card group flex items-start gap-6">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mt-1 w-28 shrink-0">10:00 – 11:00</p>
        <div>
          <h3 class="text-xl font-bold font-display text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Game Dev / Web Deb Workshops</h3>
          <p class="text-[#5F7D95] text-sm mt-1 leading-relaxed">Details.</p>
        </div>
      </div>

      <div class="card group flex items-start gap-6">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mt-1 w-28 shrink-0">12:00 – 1:00</p>
        <div>
          <h3 class="text-xl font-bold font-display text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Lunch</h3>
          <p class="text-[#5F7D95] text-sm mt-1 leading-relaxed">Details.</p>
        </div>
      </div>

      <div class="card group flex items-start gap-6">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mt-1 w-28 shrink-0">1:00 – 2:00</p>
        <div>
          <h3 class="text-xl font-bold font-display text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Art / UI Workshops</h3>
          <p class="text-[#5F7D95] text-sm mt-1 leading-relaxed">Details.</p>
        </div>
      </div>

      <div class="card group flex items-start gap-6">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mt-1 w-28 shrink-0">2:30 – 3:00</p>
        <div>
          <h3 class="text-xl font-bold font-display text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Fun Activities</h3>
          <p class="text-[#5F7D95] text-sm mt-1 leading-relaxed">Take a break and have some fun mid-jam.</p>
        </div>
      </div>

      <div class="card group flex items-start gap-6">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mt-1 w-28 shrink-0">4:30 – 5:30</p>
        <div>
          <h3 class="text-xl font-bold font-display text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Submissions</h3>
          <p class="text-[#5F7D95] text-sm mt-1 leading-relaxed">Wrap it up and submit your game before time's up.</p>
        </div>
      </div>

      <div class="card group flex items-start gap-6 border-[#769966]/30">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mt-1 w-28 shrink-0">5:30 – 6:15</p>
        <div>
          <h3 class="text-xl font-bold font-display text-[#769966] group-hover:text-[#82A7B9] transition-colors duration-300">Presentations</h3>
          <p class="text-[#5F7D95] text-sm mt-1 leading-relaxed">Show off what you made to everyone in the room.</p>
        </div>
      </div>

      <div class="card group flex items-start gap-6">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mt-1 w-28 shrink-0">6:15 – 7:00</p>
        <div>
          <h3 class="text-xl font-bold font-display text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Judging + Closing + Announcements</h3>
          <p class="text-[#5F7D95] text-sm mt-1 leading-relaxed">Description.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Sponsors -->
