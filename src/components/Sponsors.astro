---
const base = import.meta.env.BASE_URL;
---
<!-- Sponsors -->
<section id="sponsors" class="py-40 bg-linear-to-b from-transparent via-[#C5E7F1]/8 to-transparent mt-24">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-20">
      <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">Sponsors</p>
      <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-0">
        Our Sponsors
      </h2>
      <p class="text-[#5F7D95] max-w-2xl mx-auto mt-4">Thanks to those who make JellyJam possible.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="card group">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">01</p>
        <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Unity</h3>
        <img src={`${base}logos/unity.svg`} alt="Unity" class="h-8 grayscale group-hover:grayscale-0 transition-all duration-300" />
      </div>

      <div class="card group">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">02</p>
        <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">GitHub</h3>
        <img src={`${base}logos/github.svg`} alt="GitHub" class="h-8 grayscale group-hover:grayscale-0 transition-all duration-300" />
      </div>

      <div class="card group">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">03</p>
        <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">PICO-8</h3>
        <img src={`${base}logos/pico8.svg`} alt="PICO-8" class="h-8 grayscale group-hover:grayscale-0 transition-all duration-300" />
      </div>
    </div>
  </div>
</section> 