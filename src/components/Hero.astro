<!-- Hero -->
<section id="top" class="full-panel hero-panel relative overflow-visible scroll-mt-20">
  <div class="absolute inset-0 -z-20 overflow-hidden">
    <img src="/jellyjam/background.jpg" alt="" class="w-full h-full object-cover opacity-68 scale-105" />
    <div class="absolute inset-0 backdrop-blur-[2.5px] bg-linear-to-b from-[#F8FAFC]/56 via-[#F8FAFC]/64 to-[#F8FAFC]/78"></div>
  </div>

  <div class="absolute top-[12%] left-[9%] w-72 h-72 rounded-full blur-[110px] -z-10 animate-pulse-slow bg-[#C5E7F1]/55"></div>
  <div class="absolute bottom-[16%] right-[10%] w-80 h-80 rounded-full blur-[120px] -z-10 animate-pulse-slow bg-[#A3C0D3]/45" style="animation-delay: 1.6s;"></div>
  <div class="absolute top-[35%] right-[30%] w-52 h-52 rounded-full blur-[96px] -z-10 animate-wave bg-[#82A7B9]/22"></div>

  <div class="section-shell w-full grid place-items-center py-2 md:py-3">
    <div class="hero-content w-full max-w-5xl text-center px-4 md:px-10 py-4 md:py-5 animate-fade-in-up">
      <p class="section-kicker mb-2">Leland CS Club Presents</p>
      <img
        src="/jellyjam/logo.png"
        alt="JellyJam"
        class="block w-40 md:w-80 mx-auto object-contain drop-shadow-[0_8px_24px_rgba(95,125,149,0.25)]"
      />
      <p class="text-[0.95rem] md:text-base text-[#5F7D95] max-w-2xl mx-auto mt-0.5 tracking-[0.01em]">
        A 12-hour game jam in San Jose
      </p>
      <p class="text-[0.72rem] md:text-xs text-[#82A7B9] mt-1 font-secondary font-semibold tracking-[0.06em] uppercase">
        April 18, 2026 • Leland CS Club
      </p>

      <div class="mt-3 flex flex-col sm:flex-row justify-center gap-2 sm:gap-3 animate-fade-in-up" style="animation-delay: 0.25s;">
        <a href="https://forms.fillout.com/t/taUP71dZcYus" class="btn-pill btn-pill-primary">
          Register
        </a>
        <a href="mailto:lhshacks2026@gmail.com" class="btn-pill btn-pill-ghost">
          Contact Us
        </a>
      </div>
