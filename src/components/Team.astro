---
import '../styles/global.css';
const base = import.meta.env.BASE_URL;
---
<!-- Team -->
<section id="team" class="max-w-6xl mx-auto pt-8 pb-32 px-6">
  <div class="text-center mb-20">
    <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">Organizers</p>
    <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-0">The Team</h2>
    <p class="text-[#5F7D95] text-lg font-light mt-4">Meet the people behind JellyJam.</p>
  </div>

  <!-- Row 1: 4 -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-8 justify-items-center mb-8">
    <div class="text-center group cursor-pointer">
      <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
        <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden">
          <img src="/jellyjam/team_photos/catherine.webp" alt="Catherine Wang" class="group-hover:scale-110 transition-transform duration-300" />
        </div>
      </div>
      <h4 class="font-bold font-display tracking-tighter group-hover:text-[#82A7B9] transition-colors duration-300">Catherine Wang</h4>
      <p class="text-xs text-[#5F7D95] font-secondary mt-1">Lead Organizer</p>
    </div>
    <div class="text-center group cursor-pointer">
      <div class="w-32 h-32 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-4 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-110 transition-all duration-300">
