---
import '../styles/global.css';

const teamMembers = [
  { name: 'Catherine Wang', role: 'Lead Organizer', photo: 'catherine.webp', position: 'object-top' },
  { name: 'Avni Harsh', role: 'Lead Organizer', photo: 'avni.webp', position: 'object-center' },
  { name: 'Maggie Shen', role: 'Co-organizer', photo: 'maggie.jpg', position: 'object-top' },
  { name: 'Eric Ge', role: 'Co-organizer', photo: 'eric.webp', position: 'object-left' },
  { name: 'Agastya Kondamuri', role: 'Co-organizer', photo: 'agastya.webp', position: 'object-top' },
  { name: 'Stephen King', role: 'Website Dev', photo: 'stephen.webp', position: 'object-center' },
  { name: 'Anisha Patil', role: 'Marketing', photo: 'anisha.webp', position: 'object-center' },
  { name: 'Rosina Lu', role: 'Marketing', photo: 'temp.webp', position: 'object-center' },
  { name: 'Yashika Agarwal', role: 'Outreach', photo: 'yashika.webp', position: 'object-top' },
  { name: 'Katherine Zhu', role: 'Design', photo: 'katherine.webp', position: 'object-center' },
  { name: 'Sophia Hao', role: 'Outreach', photo: 'sophia.webp', position: 'object-center' },
  { name: 'Serena Ni', role: 'Website Dev', photo: 'serena.webp', position: 'object-center' },
];
---

<section id="team" class="section-shell full-panel items-start py-4 scroll-mt-2">
  <div class="w-full">
    <div class="section-heading mb-8 md:mb-10">
      <p class="section-kicker">Organizers</p>
      <h2 class="section-title">The Team</h2>
      <p class="section-subtitle text-lg font-light">Meet the people behind JellyJam.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-6 gap-x-5 gap-y-6 justify-items-center">
      {teamMembers.map((member) => (
        <div class="text-center group cursor-pointer w-full max-w-40">
          <div class="w-28 h-28 mx-auto rounded-full bg-linear-to-tr from-[#82A7B9] to-[#C5E7F1] p-1 mb-3 group-hover:shadow-[0_0_24px_rgba(197,231,241,0.6)] group-hover:scale-105 transition-all duration-300">
            <div class="w-full h-full rounded-full bg-[#F8FAFC] group-hover:scale-95 transition overflow-hidden flex items-center justify-center">
              <img
                loading="lazy"
                src={`/jellyjam/team_photos/${member.photo}`}
                alt={member.name}
                class={`group-hover:scale-110 transition-transform duration-300 object-cover ${member.position} w-full h-full`}
              />
            </div>
          </div>
          <h4 class="font-bold font-display tracking-tighter text-sm md:text-base group-hover:text-[#82A7B9] transition-colors duration-300">{member.name}</h4>
          <p class="text-xs text-[#5F7D95] font-secondary mt-1">{member.role}</p>
        </div>
      ))}
    </div>
  </div>
</section>
