---
import '../styles/global.css';
---
<!-- Rules -->
<section id="rules" class="full-panel py-3">
  <div class="section-shell">
    <div class="w-full">
      <div class="section-heading">
        <p class="section-kicker">Rules</p>
        <h2 class="section-title">
          The Rules
        </h2>
        <p class="section-subtitle">Breaking any of these rules will result in disqualification.</p>
      </div>

      <div class="grid md:grid-cols-2 gap-6">
        <div class="rules-card card group">
          <img
            src="/jellyjam/assets/jellyfish2.png"
            alt=""
            class="hidden md:block absolute -top-8 right-1 w-24 opacity-70 pointer-events-none z-20 rotate-12"
          />
          <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">01</p>
          <h3 class="text-xl md:text-[1.65rem] font-bold font-display mb-3 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Originality</h3>
          <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
            All code and assets must be made during the hackathon, or be CC0 licensed. No pre-made templates are allowed.
          </p>
        </div>

        <div class="rules-card card group">
          <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">02</p>
          <h3 class="text-xl md:text-[1.65rem] font-bold font-display mb-3 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Teams</h3>
          <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
            Participate in teams of up to 3 people, or go solo.
          </p>
        </div>

        <div class="rules-card card group">
          <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">03</p>
          <h3 class="text-xl md:text-[1.65rem] font-bold font-display mb-3 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Be Respectful</h3>
          <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
            Be kind to your fellow participants, to the organizers, and to the venue.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
