---
import '../styles/global.css';
import Question from './modules/Question.astro'
---
<!-- FAQ -->
<section id="faq" class="section-shell max-w-4xl snap-exempt py-8">
  <div class="w-full">
    <div class="section-heading mb-6">
      <p class="section-kicker">Questions</p>
      <h2 class="section-title">
        FAQ
      </h2>
      <p class="section-subtitle text-lg font-light">
        Answers to common questions.
      </p>
    </div>

    <div class="relative grid gap-4 z-10">
      <img
        src="/jellyjam/assets/shell1.png"
        alt=""
        class="hidden md:block absolute top-[32%] right-2 lg:right-0 w-20 lg:w-24 opacity-80 pointer-events-none z-20 -rotate-12"
      />
      <img
        src="/jellyjam/assets/shell2.png"
        alt=""
        class="hidden md:block absolute top-[68%] left-2 lg:left-0 w-20 lg:w-24 opacity-80 pointer-events-none z-20 rotate-12"
      />

      <Question
        question="What is a hackathon?"
        answer="A hackathon is a coding event where you build a program from scratch in a short period of time (in our case, 12 hours)."
      />
      <Question
        question="Am I eligible to participate?"
        answer="All teenagers (13–18) are eligible."
      />
      <Question
        question="What if I don't have any experience?"
        answer="That's totally fine! There'll be workshops and mentors throughout the day to help you get unstuck."
      />
      <Question
        question="Is this free?"
        answer="Yes, everything is free. Just show up!"
      />
      <Question
        question="What do I need to bring?"
        answer="A laptop, a charger, and some form of ID."
      />
      <Question
        question="What kind of projects are allowed?"
        answer="Any kind of project, as long as it's on theme! We encourage creativity and innovation."
      />
      <Question
        question="Can I work with others?"
        answer="Yes! You can form teams of up to 3 people and work together on your projects."
      />
    </div>
  </div>
</section>