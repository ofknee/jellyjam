---
import '../styles/global.css';
import Question from './modules/Question.astro'
---
<!-- FAQ -->
<section id="faq" class="max-w-6xl mx-auto pt-8 pb-32 px-6 scroll-mt-20">
  <div class="text-center mb-20">
    <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">Questions</p>
    <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-0">FAQ</h2>
    <p class="text-[#5F7D95] text-lg font-light mt-4">Answers to common questions.</p>
  </div>

  <div class="grid gap-6">
    <Question question="What is a game jam?" 
    answer="A game jam is an event where you build a game from scratch in a short period of time."/>

    <Question question="Am I eligible to participate?" 
    answer="All teenagers (13–18) are eligible. No prior experience needed."/>

    <Question question="What if I don't have any experience?" 
    answer="That's totally fine! There'll be workshops and mentors throughout the day to help you get unstuck."/>

    <Question question="Is this free?" 
    answer="Yes, everything is free - venue, food, workshops, prizes. Just show up!"/>
    
    <Question question="What do I need to bring?" 
    answer="A laptop, a charger, and your creativity. We'll help you with the rest!"/>

    <Question question="What kind of projects are allowed?" 
    answer="Any kind of project! We encourage creativity and innovation."/>

    <Question question="Can I work with others?" 
    answer="Yes! Collaborating with others is encouraged. You can form teams of up to 3 people and work together on your projects."/>
  </div>
</section>
