---
import '../styles/global.css';
---
<!-- Prizes -->
  <section id="prizes" class="max-w-6xl mx-auto py-40 px-6 mt-24">
    <div class="text-center mb-20">
      <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">Awards</p>
      <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-0">
        Prizes
      </h2>
      <p class="text-[#5F7D95] max-w-2xl mx-auto mt-4">Rewards for great work.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <div class="card group">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">1st Place</p>
        <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Gold</h3>
        <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
          TBD — check back soon.
        </p>
      </div>

      <div class="card group">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">2nd Place</p>
        <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Silver</h3>
        <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
          TBD — check back soon.
        </p>
      </div>

      <div class="card group">
        <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">3rd Place</p>
        <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">Bronze</h3>
        <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
          TBD — check back soon.
        </p>
      </div>
    </div>
  </section>