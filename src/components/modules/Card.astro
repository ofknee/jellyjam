---
interface Props {
  title: string,
  description: string,
}
import '../../styles/global.css';
const { title, description} = Astro.props;
---
<div class="card group">
  <p class="text-xs font-secondary font-semibold tracking-widest text-[#5F7D95] mb-6">02</p>
  <h3 class="text-2xl font-bold font-display mb-4 text-[#4A4A4A] group-hover:text-[#82A7B9] transition-colors duration-300">{title}</h3>
  <p class="text-[#5F7D95] leading-relaxed group-hover:text-[#5F7D95] transition-colors duration-300">
    {description}
  </p>
</div>