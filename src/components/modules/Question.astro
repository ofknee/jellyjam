---
interface Props {
  question: string,
  answer: string,
}
const { question, answer } = Astro.props;
---
<details class="faq-question glass rounded-2xl group cursor-pointer hover:bg-[#F8FAFC]/60 hover:shadow-[0_0_24px_rgba(197,231,241,0.4)] transition-all duration-300 overflow-hidden">
  <summary class="text-base md:text-[1.05rem] font-bold font-display list-none flex justify-between items-center text-[#4A4A4A] group-open:text-[#82A7B9] transition-colors duration-300 select-none p-6 md:p-7">
    {question}
    <span class="group-open:rotate-180 transition-transform duration-300 text-[#82A7B9] inline-block">↓</span>
  </summary>
  <div class="px-6 md:px-7 pb-6 md:pb-7">
    <p class="text-[#5F7D95] leading-relaxed">
      {answer}
    </p>
  </div>
</details>