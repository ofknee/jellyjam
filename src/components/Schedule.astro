---
import '../styles/global.css';
import ScheduleCard from './modules/ScheduleCard.astro';
---
<!-- Schedule -->
<section id="schedule" class="min-h-fit bg-linear-to-b from-transparent via-[#C5E7F1]/8 to-transparent">
  <div class="max-w-6xl mx-auto px-6">
    <div class="text-center mb-20">
      <p class="text-xs uppercase tracking-widest text-[#5F7D95] mb-4 font-secondary">Day Of</p>
      <h2 class="text-5xl md:text-6xl font-black font-display tracking-tighter text-[#769966] mb-0">
        The Schedule
      </h2>
      <p class="text-[#5F7D95] max-w-2xl mx-auto mt-4">One day. Make something awesome.</p>
    </div>
    <div class="max-w-3xl mx-auto flex flex-col gap-4">
      <ScheduleCard title="Check In" time="9:00 – 9:45" description="Get settled, meet your team, and get ready to build." />
      
      <ScheduleCard title="Game Dev / Web Deb Workshops" time="10:00 – 11:00" description="Details." />
      
      <ScheduleCard title="Lunch" time="12:00 – 1:00" description="Details." />
      
      <ScheduleCard title="Art / UI Workshops" time="1:00 – 2:00" description="Details." />
      
      <ScheduleCard title="Fun Activities" time="2:30 – 3:00" description="Take a break and have some fun mid-jam." />
      
      <ScheduleCard title="Submissions" time="4:30 – 5:30" description="Wrap it up and submit your game before time's up." />
  
      <ScheduleCard title="Presentations" time="5:30 – 6:15" description="Show off what you made to everyone in the room."/>
  
      <ScheduleCard title="Judging + Closing + Announcements" time="6:15 – 7:00" description="Description." />
    </div>
  </div>
</section>