---
import '../styles/global.css';
import ScheduleCard from './modules/ScheduleCard.astro';
---
<!-- Schedule -->
<section id="schedule" class="section-shell full-panel py-3">
  <div class="w-full">
    <div class="section-heading">
      <p class="section-kicker">Day Of</p>
      <h2 class="section-title">
        The Schedule
      </h2>
      <p class="section-subtitle">April 18, 2026</p>
    </div>

    <div class="relative max-w-4xl mx-auto grid md:grid-cols-2 gap-4 bg-transparent">
      <img
        src="/jellyjam/assets/shell2.png"
        alt=""
        class="absolute bottom-1/3 right-32 w-40 opacity-60 pointer-events-none z-20 -rotate-12"
      />

      <ScheduleCard title="Check In" time="9:00 – 9:45" description="Get settled, meet your team, and get ready to build." />
      <ScheduleCard title="Game Dev / Web Deb Workshops" time="10:00 – 11:00" description="Details coming soon." />
      <ScheduleCard title="Lunch" time="12:00 – 1:00" description="Food will be provided!" />
      <ScheduleCard title="Art / UI Workshops" time="1:00 – 2:00" description="Details coming soon." />
      <ScheduleCard title="Fun Activities" time="2:30 – 3:00" description="Take a break and have some fun mid-jam." />
      <ScheduleCard title="Submissions" time="4:30 – 5:30" description="Wrap it up and submit your game before time's up." />
      <ScheduleCard title="Presentations" time="5:30 – 6:15" description="Show off what you made to everyone in the room." />
      <ScheduleCard title="Judging + Closing + Announcements" time="6:15 – 7:00" description="Thanks for coming!" />
    </div>
  </div>
</section>