---
import DiscordIcon from './icons/Discord.astro';
import GithubIcon from './icons/Github.astro';
import InstagramIcon from './icons/Instagram.astro';
---

<nav class="sticky top-0 z-100 w-full">
	<div class="glass glass-header border-b border-[#D9E4F5]">
		<div class="w-full px-2 md:px-4 h-16 relative flex items-center justify-between">			<div class="h-16 flex items-center">
			<a href="#top" class="block">
				<img
				src="/jellyjam/logo.png"
				alt="Jelly Jam"
				class="block h-22 w-auto"
				/>
			</a>
			</div>
			<div class="hidden md:flex absolute left-1/2 -translate-x-1/2 items-center gap-6 font-secondary font-semibold text-sm uppercase tracking-wider text-[#4A4A4A]">
				<a href="#about" class="hover:text-[#82A7B9] transition-colors">About</a>
				<a href="#team" class="hover:text-[#82A7B9] transition-colors">Team</a>
				<a href="#schedule" class="hover:text-[#82A7B9] transition-colors">Schedule</a>
				<a href="#faq" class="hover:text-[#82A7B9] transition-colors">FAQ</a>
			</div>

			<div class="flex items-center gap-3 md:gap-5">
				<div class="flex items-center gap-2 md:gap-3 text-[#5F7D95]">
					<a href="https://www.instagram.com/jellyjam2026/" target="_blank" class="hover:text-[#4A4A4A] transition-all hover:scale-110 duration-300" aria-label="Instagram">
						<InstagramIcon class="w-5 h-5" />
					</a>
					<a href="https://discord.gg/CRkvFvxY" target="_blank" class="hover:text-[#4A4A4A] transition-all hover:scale-110 duration-300" aria-label="Discord">
						<DiscordIcon class="w-5 h-5" />
					</a>
					<a href="https://github.com/ofknee/jellyjam" target="_blank" class="hover:text-[#4A4A4A] transition-all hover:scale-110 duration-300" aria-label="GitHub">
						<GithubIcon class="w-5 h-5" />
					</a>
				</div>

				<a href="https://forms.fillout.com/t/taUP71dZcYus" class="hidden sm:inline-flex px-4 py-2 rounded-full text-sm font-secondary font-semibold text-[#4A4A4A] border border-[#C5E7F1] hover:bg-[#C5E7F1]/30 transition-all duration-300">
					Register
				</a>
			</div>
		</div>
	</div>
</nav>
